# Uploaded photos are served as images and never executed.
php_flag engine off
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
<FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
